{
  "name": "stream-layer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/stream-layer.umd.js",
  "module": "./dist/stream-layer.es.js",
  "types": "./dist/widget.d.ts",
  "exports": {
    ".": {
      "types": "./dist/widget.d.ts",
      "import": "./dist/stream-layer.es.js",
      "require": "./dist/stream-layer.umd.js"
    },
    "./style.css": "./dist/stream-layer.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:app": "tsc -b && vite build -c vite.app.config.ts",
    "mobile:init": "npx cap init",
    "mobile:android": "npx cap add android",
    "mobile:sync": "npx cap sync",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.2",
    "@capacitor/app": "^8.0.1",
    "@capacitor/cli": "^7.4.5",
    "@capacitor/core": "^8.0.2",
    "@capacitor/toast": "^8.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "hls.js": "^1.6.15",
    "lucide-react": "^0.562.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-css-injected-by-js": "^3.5.2"
  }
}
