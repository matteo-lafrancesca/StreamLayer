{
  "name": "stream-layer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/stream-layer.umd.js",
  "module": "./dist/stream-layer.es.js",
  "types": "./dist/widget.d.ts",
  "exports": {
    ".": {
      "types": "./dist/widget.d.ts",
      "import": "./dist/stream-layer.es.js",
      "require": "./dist/stream-layer.umd.js"
    },
    "./style.css": "./dist/stream-layer.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:app": "tsc -b && vite build -c vite.app.config.ts",
    "mobile:init": "npx cap init",
    "mobile:android": "npx cap add android",
    "mobile:sync": "npx cap sync",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "@capacitor/android": "8.1.0",
    "@capacitor/app": "8.0.1",
    "@capacitor/cli": "8.1.0",
    "@capacitor/core": "8.1.0",
    "@capacitor/ios": "8.1.0",
    "@capacitor/toast": "8.0.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "hls.js": "1.6.15",
    "lucide-react": "0.562.0"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.13",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react-swc": "4.2.3",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.55.0",
    "vite": "7.3.1",
    "vite-plugin-css-injected-by-js": "3.5.2"
  }
}
